import React, {useState} from 'react';
import {ScrollView, StyleSheet, Text, TextInput} from 'react-native';
import {Body, Card, PrimaryButton, Screen, SecondaryButton, Subtitle, Title, palette} from '../components/ui';
import {detectLocation} from '../services/location';
import type {LocationInfo} from '../types';

export function LocationScreen({
  initial,
  onContinue,
  onBack,
}: {
  initial: LocationInfo | null;
  onContinue: (location: LocationInfo) => void;
  onBack: () => void;
}) {
  const [location, setLocation] = useState<LocationInfo | null>(initial);
  const [name, setName] = useState(initial?.name || '');
  const [address, setAddress] = useState(initial?.address || '');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const detect = async () => {
    setLoading(true);
    setError('');
    try {
      const found = await detectLocation();
      setLocation(found);
      setAddress(found.address);
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setLoading(false);
    }
  };

  const save = () => {
    if (!location || !address.trim()) return;
    onContinue({...location, name: name.trim(), address: address.trim()});
  };

  return (
    <Screen>
      <ScrollView>
        <Title>Identify this property</Title>
        <Body>GPS is captured automatically. The phone's native geocoder can suggest the area, but you confirm the exact hotel/rental address so no paid maps API is needed.</Body>

        <PrimaryButton title={location ? 'REFRESH GPS LOCATION' : 'USE MY CURRENT LOCATION'} onPress={detect} loading={loading} />
        {error ? <Text style={styles.error}>{error}</Text> : null}

        {location ? (
          <Card>
            <Subtitle>GPS captured</Subtitle>
            <Text style={styles.coords}>{location.lat.toFixed(6)}, {location.lng.toFixed(6)}</Text>
            {location.accuracy ? <Body>Approx. accuracy: {Math.round(location.accuracy)} m</Body> : null}
          </Card>
        ) : null}

        <Text style={styles.label}>Property / hotel name</Text>
        <TextInput
          value={name}
          onChangeText={setName}
          placeholder="Example: Room 214, Example Hotel"
          placeholderTextColor={palette.muted}
          style={styles.input}
        />

        <Text style={styles.label}>Confirmed address</Text>
        <TextInput
          value={address}
          onChangeText={setAddress}
          placeholder="Street address or property description"
          placeholderTextColor={palette.muted}
          style={[styles.input, styles.multiline]}
          multiline
        />

        <PrimaryButton title="CONFIRM PROPERTY" onPress={save} disabled={!location || !address.trim()} />
        <SecondaryButton title="Back" onPress={onBack} />
      </ScrollView>
    </Screen>
  );
}

const styles = StyleSheet.create({
  error: {color: palette.danger, marginTop: 10},
  coords: {color: palette.text, fontWeight: '700', marginBottom: 6},
  label: {color: palette.text, fontSize: 13, fontWeight: '800', marginBottom: 6, marginTop: 12},
  input: {backgroundColor: palette.panel, borderColor: palette.border, borderWidth: 1, borderRadius: 14, color: palette.text, minHeight: 50, paddingHorizontal: 14, fontSize: 15},
  multiline: {minHeight: 80, paddingTop: 14, textAlignVertical: 'top'},
});
